@messageId = 63b2d9f0-126c-4377-98ec-d79bc853e7ac

###  일대일 대화 신청 
POST {{baseUrl}}/direct-chat/request/{{targetUserId}}
Authorization: Bearer {{user1Token}}


###내가 받은 대화 신청 목록 조회 
GET {{baseUrl}}/direct-chat/requests/pending
Authorization: Bearer {{user2Token}}


###  대화 신청 수락 
PATCH {{baseUrl}}/direct-chat/{{directRoomId}}/accept
Authorization: Bearer {{user2Token}}

### 대화 신청 거절 
PATCH {{baseUrl}}/direct-chat/{{directRoomId}}/reject
Authorization: Bearer {{user2Token}}

### 내 일대일 대화방 목록 조회 
GET {{baseUrl}}/direct-chat/rooms
Authorization: Bearer {{user1Token}}

### 일대일 대화방 메시지 목록 조회 
GET {{baseUrl}}/direct-chat/rooms/{{directRoomId}}/messages
Authorization: Bearer {{user1Token}}

###  일대일 대화방 메시지 전송 
POST {{baseUrl}}/direct-chat/rooms/{{directRoomId}}/messages
Authorization: Bearer {{user1Token}}
Content-Type: application/json

{
  "message": "반가워요! 일대일 메시지 테스트입니다."
}

###  일대일 대화방 메시지 삭제 
DELETE {{baseUrl}}/direct-chat/messages/{{messageId}}
Authorization: Bearer {{user1Token}}


### 일대일 대화방 나가기 (대화방 및 메시지 전체 삭제)
DELETE {{baseUrl}}/direct-chat/rooms/{{directRoomId}}/leave
Authorization: Bearer {{user1Token}}