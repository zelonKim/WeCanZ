{
  "expo": {
    "name": "종태원",
    "slug": "jongtaewon",
    "scheme": "jongtaewon",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "backgroundColor": "#121212",
      "barStyle": "light-content"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zelon.jongtaewon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "음성 메시지 전송 및 음성 통화 기능 이용 시, 사용자 음성을 녹음하기 위해 마이크 권한에 접근합니다.",
        "NSPhotoLibraryUsageDescription": "프로필 사진 설정 및 게시글/채팅에 이미지를 첨부하기 위해 사진 라이브러리에 접근합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#121212"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.zelon.jongtaewon"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.277459634612-2sq917cvk9iv5he2jpfceahno01aqug4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "704ff0b6-ec80-4082-b937-a6f340dc9d2a"
      }
    }
  }
}
